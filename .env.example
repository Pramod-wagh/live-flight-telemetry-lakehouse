# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR LIVE FLIGHT DATA ENGINEERING STACK
# Copy this file to .env before running `docker compose up -d`
# ==============================================================================

# --- General Project Settings ---
COMPOSE_PROJECT_NAME=flight-pipeline

# --- PostgreSQL Settings (Exposed on 5433 for Power BI & pgAdmin) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
AIRFLOW_DB=airflow
ICEBERG_CATALOG_DB=iceberg_catalog
FLIGHT_SERVING_DB=flight_serving

# --- MinIO (S3 Object Storage) Settings ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminpassword123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_RAW_BUCKET=flight-raw
MINIO_ICEBERG_BUCKET=flight-lakehouse

# --- Apache Airflow Settings ---
AIRFLOW_IMAGE_NAME=flight-airflow-pyspark:latest
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__EXECUTION_TIMEOUT=300
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
_PIP_ADDITIONAL_REQUIREMENTS=""

# --- Apache Spark & Iceberg Settings ---
SPARK_MASTER_PORT=7077
SPARK_WEBUI_PORT=8082
SPARK_VERSION=3.5.1
ICEBERG_VERSION=1.5.2

