FROM apache/airflow:2.9.3-python3.11

USER root

# Install OpenJDK 17 for PySpark execution
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        curl \
        procps && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER airflow

# Install Python packages: PySpark, MinIO client, S3 support, OpenSky client utilities, and Postgres driver
RUN pip install --no-cache-dir \
    pyspark==3.5.1 \
    minio==7.2.7 \
    s3fs==2024.6.1 \
    pyarrow==16.1.0 \
    psycopg2-binary==2.9.9 \
    requests==2.32.3
